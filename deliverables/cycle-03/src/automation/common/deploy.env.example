# Shared deployment configuration
HUB_HOST=192.168.1.100
HUB_PORT=8081
SYNC_KEY_FILE=sync_key.txt

# Meshtastic settings
MESH_CHANNEL=field
MESH_PSK=your-psk-here
MESH_REGION=US

# Serial ports
K10_SERIAL=/dev/ttyACM0
HELTEC1_PORT=/dev/ttyUSB0
HELTEC2_PORT=/dev/ttyUSB1
HELTEC3_PORT=/dev/ttyUSB2
TDECK_PORT=/dev/ttyUSB3
